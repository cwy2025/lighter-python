# Lighter交易所API配置
LIGHTER_API_KEY=your_api_key_here
LIGHTER_API_SECRET=your_api_secret_here
LIGHTER_ACCOUNT_ID=1

# API端点配置
LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai
LIGHTER_TESTNET_URL=https://testnet.zklighter.elliot.ai
LIGHTER_USE_TESTNET=false
LIGHTER_WS_URL=wss://ws.lighter.xyz

# 监控配置
REFRESH_INTERVAL=60
DISPLAY_PRECISION=6

# 请求配置
TIMEOUT=30
MAX_RETRIES=3

# WebSocket配置
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10