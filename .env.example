# Lighter交易所API配置
LIGHTER_API_KEY=your_api_key_here
LIGHTER_API_SECRET=your_api_secret_here

# API端点（可选，使用默认值）
LIGHTER_BASE_URL=https://api.lighter.xyz
LIGHTER_WS_URL=wss://ws.lighter.xyz

# 监控配置
REFRESH_INTERVAL=60
DISPLAY_PRECISION=6

# 请求配置
TIMEOUT=30
MAX_RETRIES=3

# WebSocket配置
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10